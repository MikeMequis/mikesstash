{%if settings.dgHomeLink === true%}
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" style="text-decoration: none;">
                {% if meta.siteLogoPath %}
                    <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{meta.siteName}}" data-title-pt="{{ meta.siteNames.pt }}" data-title-en="{{ meta.siteNames.en }}">
                {% endif %}
                <div class="site-title-group">
                    <h1 style="margin: 15px !important;" data-title-pt="{{ meta.siteNames.pt }}" data-title-en="{{ meta.siteNames.en }}">{{meta.siteName}}</h1>
                    {% if meta.siteDescription %}
                        <p class="site-description" data-desc-pt="{{ meta.siteDescriptions.pt }}" data-desc-en="{{ meta.siteDescriptions.en }}">{{ meta.siteDescription }}</p>
                    {% endif %}
                </div>
            </a>
        </div>
        <div class="navbar-actions">
            {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
            {% include "components/pagePanelButton.njk" %}
        </div>
    </nav>
    {%else%}
    <div class="empty-navbar" >
        {% set slotName = "navbar.actions" %}{% include "components/pluginSlot.njk" %}
    </div>
{%endif%}