{%if settings.dgHomeLink === true%}
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" style="text-decoration: none;">
            {% if meta.siteLogoPath %}
            <img class="site-logo"
            src="{{ meta.siteLogoPath }}"
            alt="{{ meta.siteName }}"
            data-title-pt="{{ meta.siteNames.pt }}"
            data-title-en="{{ meta.siteNames.en }}">
    {% endif %}

    <div class="site-title-group">
        <h1 data-title-pt="{{ meta.siteNames.pt }}" data-title-en="{{ meta.siteNames.en }}">{{ meta.siteName }}</h1>

        {% if meta.siteDescription %}
            <p class="site-description"
                data-desc-pt="{{ meta.siteDescriptions.pt }}"
                data-desc-en="{{ meta.siteDescriptions.en }}">
                {{ meta.siteDescription }}
            </p>
        {% endif %}
    </div>
</a>
        </div>
        {% if settings.dgEnableSearch === true%}
            {% include "components/searchButton.njk" %}
        {%endif%}
    </nav>
    {%else%}
    <div class="empty-navbar" >
        {% if settings.dgEnableSearch === true%}
            {% include "components/searchButton.njk" %}
        {%endif%}
    </div>
{%endif%}