<nav class="navbar">
    <div class="navbar-inner">
        <span style="font-size: 1.5rem; margin-right: 10px;" @click="showFilesMobile=!showFilesMobile"><i  data-lucide="menu"></i></span>
        {% for imp in dynamics.filetree.beforeTitle %}
            {% include imp %}
        {% endfor %}
        {%- set inPortfolio = portfolioContext is not null -%}
        {%- set navHref = '/portfolio/' if inPortfolio else '/' -%}
        {%- set navNamePt = meta.portfolioSiteNames.pt if inPortfolio else meta.siteNames.pt -%}
        {%- set navNameEn = meta.portfolioSiteNames.en if inPortfolio else meta.siteNames.en -%}
        {%- set navName = meta.portfolioSiteName if inPortfolio else meta.siteName -%}
        {%- set navDescPt = meta.portfolioSiteDescriptions.pt if inPortfolio else meta.siteDescriptions.pt -%}
        {%- set navDescEn = meta.portfolioSiteDescriptions.en if inPortfolio else meta.siteDescriptions.en -%}
        {%- set navDesc = meta.portfolioSiteDescription if inPortfolio else meta.siteDescription -%}
        <a href="{{ navHref }}" style="text-decoration: none; flex: 1; display: flex; flex-direction: column; align-items: center; text-align: center;">
            {% if meta.siteLogoPath %}
                <img class="site-logo" src="{{meta.siteLogoPath}}" alt="{{navName}}" data-title-pt="{{navNamePt}}" data-title-en="{{navNameEn}}">
            {% endif %}
            <div class="site-title-group">
                <h1 style="margin: 15px !important;" data-title-pt="{{navNamePt}}" data-title-en="{{navNameEn}}">{{navName}}</h1>
                {% if navDesc %}
                    <p class="site-description" data-desc-pt="{{navDescPt}}" data-desc-en="{{navDescEn}}">{{ navDesc }}</p>
                {% endif %}
            </div>
        </a>
        {% for imp in dynamics.filetree.afterTitle %}
            {% include imp %}
        {% endfor %}
    </div>

    {% if settings.dgEnableSearch === true%}
        {% include "components/searchButton.njk" %}
    {%endif%}
</nav>